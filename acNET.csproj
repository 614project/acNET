<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- .NET 5 이상 등에서 쓸 수 있도록 .NET Standard 2.1 을 대상으로 합니다. (빌드는 .NET 10 SDK) -->
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>AcNET</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>acNET</PackageId>
		<PackageProjectUrl>https://github.com/614project/acNET</PackageProjectUrl>
		<RepositoryUrl>https://github.com/614project/acNET</RepositoryUrl>
		<Description>solved.ac API (v4) wrapper for C#
(unofficial)
</Description>
		<Title>acNET</Title>
		<Copyright>made by 614project</Copyright>
		<PackageIcon>acNETIcon.png</PackageIcon>
		<PackageReadmeFile>Nuget.md</PackageReadmeFile>
		<PackageTags>solved.ac, solvedac, baekjoon, boj, wrapper, api, library</PackageTags>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<FileVersion>1.0.0</FileVersion>
		<Version>1.0.0</Version>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<IncludeSymbols>True</IncludeSymbols>
		<ApplicationIcon>acNETIcon.ico</ApplicationIcon>
		<Authors>614project</Authors>
		<PackAsTool>False</PackAsTool>
		<!-- 테스트 프로젝트는 같은 폴더 아래에 있지만 라이브러리에 포함되지 않도록 제외합니다. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
	</PropertyGroup>

	<PropertyGroup>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="acNETIcon.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Nuget.md" Pack="true" PackagePath="\" />
		<None Include="acNETIcon.png" Pack="true" PackagePath="\" />
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<!--
		  .NET Standard 2.1 에는 System.Text.Json 이 없어서 패키지로 참조합니다.
		  8.0 이상은 .NET 5 등에서 'doesn't support' 경고를 내므로, 경고 없이 netcoreapp3.1 이상을 지원하는 6.0 계열을 씁니다.
		  .NET 6 이상에서는 프레임워크에 들어있는 더 높은 버전이 사용됩니다.
		-->
		<PackageReference Include="System.Text.Json" Version="6.0.11" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="acNET.Tests" />
	</ItemGroup>

</Project>
